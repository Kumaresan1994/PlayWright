import { test, expect, Page } from '@playwright/test';
import { primeLoginPage } from './loginpage';
import { SearchCustomer } from './searchcustomerpage';

// Shared credentials
const orgCode = 'PCST2';
const username = 'e3026913';
const password = 'install';

test.describe('Login and Search Tests', () => {
    let page: Page;

    test.beforeAll(async ({ browser }) => {
        // Launch browser once for all tests
        page = await browser.newPage();
        
        // Perform login once
        const loginPage = new primeLoginPage(page);
        await loginPage.LoginMBPapplication(orgCode, username, password, test.info());
    });

    test.afterAll(async () => {
        // Close browser after all tests
        await page.close();
    });

    test('Verify page title after login', async () => {
        // Verify the page title
        await expect(page.locator('text=Logoff')).toBeVisible();
    });

    test("Verify customer search functionality", async () => {
        // Create search customer instance
        const searchCustomer = new SearchCustomer(page);
        
        // Perform the customer search
        const popup = await searchCustomer.searchCustomerById();
        
        // Verify the popup is opened successfully
        expect(popup).not.toBeNull();
        const popupTitle = await popup.title();
        console.log(`Popup title: ${popupTitle}`);
        expect(popupTitle).toBeTruthy();
        
        // Close the popup
        await popup.close();
    });
});